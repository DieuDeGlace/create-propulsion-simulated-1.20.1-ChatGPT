{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base" } },
    { "when": { "facing": "south" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "y": 270 } },
    { "when": { "facing": "east" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "y": 90 } },
    { "when": { "facing": "up", "axis_along_first": "false" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "x": 270 } },
    { "when": { "facing": "up", "axis_along_first": "true" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "x": 270, "y": 90 } },
    { "when": { "facing": "down", "axis_along_first": "false" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "x": 90 } },
    { "when": { "facing": "down", "axis_along_first": "true" }, "apply": { "model": "createpropulsion:block/tilt_adapter_base", "x": 90, "y": 90 } }
  ]
}
